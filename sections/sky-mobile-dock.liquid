<nav class="sk-dock" aria-label="Quick navigation">
  <div class="sk-dock__pill">
    <button type="button" data-dock="search"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8.6" cy="8.6" r="6"/><path d="M13.2 13.2l4.3 4.3"/></svg><span>Search</span></button>
    <a href="{{ routes.root_url }}"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M3 9l7-6 7 6v8H3z"/><path d="M8 17v-5h4v5"/></svg><span>Home</span></a>
    <button type="button" data-dock="menu"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg><span>Menu</span></button>
    <a href="{{ routes.account_url }}"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="10" cy="6.5" r="3.5"/><path d="M3.5 17c.6-3.3 3.3-5 6.5-5s5.9 1.7 6.5 5"/></svg><span>Account</span></a>
  </div>
  <a href="{{ routes.cart_url }}" class="sk-dock__cart" aria-label="Cart">
    <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.5h15l-1.4 8.5H3.9zM6.5 7.5L10 2.5l3.5 5"/></svg>
    <span>Cart</span>
    <b class="sk-dock__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</b>
  </a>
</nav>

{% stylesheet %}
  .sk-dock { display: none; }
  @media (max-width: 989px) {
    body { padding-bottom: 88px; }
    .sk-dock { position: fixed; z-index: 58; left: 12px; right: 12px; bottom: 12px; display: flex; gap: 8px; align-items: stretch; }
    .sk-dock__pill { flex: 1; display: flex; align-items: center; justify-content: space-around; height: 64px; padding: 0 6px; border-radius: 999px; background: rgba(70,70,74,.5); -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4); color: #fff; box-shadow: 0 6px 24px rgba(0,0,0,.18); }
    .sk-dock__pill a, .sk-dock__pill button, .sk-dock__cart { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: 1; padding: 0; border: 0; background: none; color: inherit; font-size: 11px; line-height: 1; }
    .sk-dock__cart { position: relative; flex: none; width: 64px; height: 64px; border-radius: 50%; background: #000; color: #fff; box-shadow: 0 6px 24px rgba(0,0,0,.2); }
    .sk-dock__count { position: absolute; top: 8px; right: 10px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: #d93025; font-size: 10px; line-height: 16px; text-align: center; }
    .sk-top { bottom: 92px; right: 14px; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-dock]');
    if (!b) return;
    var t = document.querySelector(b.dataset.dock === 'menu' ? 'sky-header [data-menu-open]' : 'sky-header [data-search-open]');
    if (t) t.click();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Mobile bottom bar",
  "settings": [
    { "type": "header", "content": "Shown on phones and tablets (under 990px)" }
  ],
  "presets": [{ "name": "Mobile bottom bar" }]
}
{% endschema %}
