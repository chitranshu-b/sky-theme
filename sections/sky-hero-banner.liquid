{%- assign s = section.settings -%}
<section class="sk-hero" style="--hero-h: {{ s.height }}vh; --hero-ov: {{ s.overlay | divided_by: 100.0 }}; --mq-size: {{ s.marquee_size }}px; --hero-fg: {{ s.text_color }};">
  <div class="sk-hero__bg">
    {%- if s.image != blank -%}
      <img src="{{ s.image | image_url: width: 2000 }}" srcset="{{ s.image | image_url: width: 900 }} 900w, {{ s.image | image_url: width: 1500 }} 1500w, {{ s.image | image_url: width: 2400 }} 2400w" sizes="100vw" alt="{{ s.image.alt | escape }}" width="2000" height="{{ 2000 | divided_by: s.image.aspect_ratio | round }}" fetchpriority="high">
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'sk-ph' }}
    {%- endif -%}
    <span class="sk-hero__shade"></span>
  </div>

  {%- if s.marquee_text != blank -%}
    <div class="sk-hero__marquee" data-sk-marquee data-pxs="{{ s.marquee_pxs | default: 85 }}" aria-hidden="true">
      <div class="sk-marquee__inner">
        <span>{{ s.marquee_text }}</span><span class="sep"></span>
      </div>
    </div>
  {%- endif -%}

  <div class="sk-hero__content sk-container">
    <div class="sk-hero__left">
      <h2 class="sk-hero__title" data-sk-words>{{ s.heading }}</h2>
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="sk-btn">
          <span>{{ s.button_label }}</span>
          <span class="sk-btn__icon">
            <svg viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M1 7l6-6M2 1h5v5"/></svg>
            <svg viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M1 7l6-6M2 1h5v5"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>
    {%- if s.text != blank -%}<p class="sk-hero__text" data-sk-reveal>{{ s.text }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sk-hero { position: relative; display: flex; align-items: flex-end; min-height: max(520px, var(--hero-h)); overflow: hidden; color: var(--hero-fg); background: #000; }
  .sk-hero__bg { position: absolute; inset: 0; }
  .sk-hero__bg img, .sk-hero__bg .sk-ph { width: 100%; height: 100%; object-fit: cover; }
  .sk-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,calc(var(--hero-ov) * 1)), rgba(0,0,0,calc(var(--hero-ov) * .22)) 26%, rgba(0,0,0,calc(var(--hero-ov) * .1)) 100%); }
  .sk-hero__marquee { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); overflow: hidden; mix-blend-mode: overlay; pointer-events: none; white-space: nowrap; }
  .sk-hero__marquee .sk-marquee__inner { display: inline-flex; align-items: center; width: max-content; animation: sk-mq 14s linear infinite; }
  .sk-hero__marquee span { font-family: var(--sk-font-head); font-weight: 600; font-size: var(--mq-size, 180px); line-height: 1.1; color: #fff; }
  .sk-hero__marquee .sep { display: inline-block; width: .35em; }
  @keyframes sk-mq { to { transform: translateX(-50%); } }
  .sk-hero__content { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end; gap: 28px; padding-top: 140px; padding-bottom: 40px; }
  @media (min-width: 750px) { .sk-hero__content { flex-direction: row; align-items: flex-end; justify-content: space-between; } }
  .sk-hero__left { display: grid; gap: 28px; justify-items: start; }
  .sk-hero__title { color: var(--hero-fg); font-size: clamp(34px, 4.4vw, 62px); font-weight: 500; line-height: 1.12; max-width: 12ch; }
  .sk-hero__text { max-width: 360px; font-size: 16px; line-height: 1.45; font-weight: 500; }
  @media (max-width: 749px) { .sk-hero__marquee span { font-size: calc(var(--mq-size, 180px) * .5); } }
  @media (prefers-reduced-motion: reduce) { .sk-hero__marquee .sk-marquee__inner { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 100 },
    { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#ffffff" },
    { "type": "header", "content": "Running text on the banner" },
    { "type": "text", "id": "marquee_text", "label": "Running text", "default": "Spring Sale" },
    { "type": "range", "id": "marquee_size", "label": "Running text size", "min": 60, "max": 320, "step": 10, "unit": "px", "default": 180 },
    { "type": "range", "id": "marquee_pxs", "label": "Running text speed (higher = faster)", "min": 10, "max": 300, "step": 5, "default": 85, "info": "85 = same speed as the original demo. Lower the number to slow it down." },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The New Season Starts Here" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Curated wardrobe staples crafted from premium fabrics, blending timeless silhouettes with effortless versatility to create confident style for every season." }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
