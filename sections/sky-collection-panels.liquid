{%- assign s = section.settings -%}
<div class="sk-space" style="padding-top: {{ section.settings.pt }}px; padding-bottom: {{ section.settings.pb }}px;">
{%- if s.bg_image != blank -%}{%- assign bg_url = s.bg_image | image_url: width: 1600 -%}{%- else -%}{%- assign bg_url = 'sky-panel-bg.jpg' | asset_url -%}{%- endif -%}
<section class="sk-cp" style="--cp-font: '{{ s.title_font }}', cursive; --cp-bgimg: url('{{ bg_url }}');">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.title_font | replace: ' ', '+' }}&display=swap">
  <div class="sk-cp__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="sk-cp__panel" href="{{ b.link | default: '#' }}" style="--cp-bg: {{ b.bg }}; --cp-fg: {{ b.fg }};" {{ block.shopify_attributes }}>
        <span class="sk-cp__eyebrow">{{ b.eyebrow }}</span>
        <span class="sk-cp__title">{{ b.title }}</span>

        <span class="sk-cp__chips" aria-hidden="true">
          {%- assign feats = b.features | newline_to_br | split: '<br />' -%}
          {%- for f in feats -%}
            {%- assign ft = f | strip | strip_newlines -%}
            {%- if ft != blank -%}
              {%- assign parts = ft | split: '|' -%}
              {%- assign chip_label = parts[0] | strip -%}
              {%- assign chip_icon = parts[1] | strip | default: 'dot' -%}
              <span class="sk-cp__chip" style="--d: {{ forloop.index0 | times: 100 | plus: 50 }}ms">{% render 'sky-chip-icon', icon: chip_icon %}<span>{{ chip_label }}</span></span>
            {%- endif -%}
          {%- endfor -%}
        </span>

        <span class="sk-cp__figures">
          <span class="sk-cp__fig sk-cp__fig--a">
            {%- if b.image != blank -%}<img src="{{ b.image | image_url: width: 700 }}" alt="{{ b.image.alt | escape }}" width="700" height="{{ 700 | divided_by: b.image.aspect_ratio | round }}" loading="lazy">{%- else -%}{{ 'image' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}
          </span>
          <span class="sk-cp__fig sk-cp__fig--b">
            {%- if b.image_hover != blank -%}<img src="{{ b.image_hover | image_url: width: 700 }}" alt="" width="700" height="{{ 700 | divided_by: b.image_hover.aspect_ratio | round }}" loading="lazy">{%- endif -%}
          </span>
        </span>

        <span class="sk-cp__cta sk-link">{{ b.link_label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
</div>

{% stylesheet %}
  .sk-cp__grid { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 750px) { .sk-cp__grid { grid-template-columns: 1fr 1fr; } }
  .sk-cp__panel { position: relative; display: block; min-height: clamp(460px, 56vw, 620px); padding: 34px 20px 28px; overflow: hidden; text-align: center; color: var(--cp-fg, #000); background: var(--cp-bg, #e4e8ea) var(--cp-bgimg) center bottom / cover no-repeat; border-right: 1px solid rgba(255,255,255,.6); isolation: isolate; }
  .sk-cp__eyebrow { display: block; font-size: 12px; letter-spacing: .1px; line-height: 1.35; text-transform: uppercase; }
  @media (max-width: 1024px) { .sk-cp__title { font-size: 51.5px; } }
  @media (max-width: 767px) { .sk-cp__title { font-size: 37.7px; } }
  .sk-cp__title { display: block; margin-top: 12px; font-family: var(--cp-font); font-size: 72px; font-weight: 400; line-height: 1.2; transition: transform .6s cubic-bezier(.2,.7,.2,1); transform-origin: 50% 0; }
  .sk-cp__panel:hover .sk-cp__title { transform: scale(1.06); }
  .sk-cp__figures { position: absolute; left: 50%; bottom: 56px; width: min(78%, 360px); height: 62%; transform: translateX(-50%); display: block; z-index: 1; }
  .sk-cp__fig { position: absolute; bottom: 0; display: block; height: 100%; transition: transform .7s cubic-bezier(.2,.7,.2,1), opacity .5s; }
  .sk-cp__fig img, .sk-cp__fig .sk-ph { height: 100%; width: auto; max-width: none; object-fit: contain; mix-blend-mode: multiply; }
  .sk-cp__fig--a { left: 50%; transform: translateX(-50%); }
  .sk-cp__fig--b { left: 50%; opacity: 0; transform: translateX(-50%); }
  .sk-cp__panel:hover .sk-cp__fig--a { transform: translateX(-88%); }
  .sk-cp__panel:hover .sk-cp__fig--b { opacity: 1; transform: translateX(-12%); }
  .sk-cp__chips { position: absolute; z-index: 3; left: 20px; top: 50%; transform: translateY(-50%); display: grid; gap: 4px; justify-items: start; text-align: left; }
  @media (min-width: 1200px) { .sk-cp__chips { left: 50px; } }
  .sk-cp__chip { display: inline-flex; align-items: center; gap: 8px; width: max-content; padding: 8px 10px; border-radius: 8px; background: #fff; color: #2b2b2b; font-size: 12px; font-weight: 400; line-height: 1.35; opacity: 0; transform: translateX(-10px); transition: opacity .5s ease-in-out var(--d), transform .5s ease-in-out var(--d); }
  .sk-cp__icon { flex: 0 0 auto; width: 15px; height: 15px; color: #000; }
  @media (min-width: 1200px) { .sk-cp__icon { width: 20px; height: 20px; } }
  .sk-cp__panel:hover .sk-cp__chip, .sk-cp__panel:focus-visible .sk-cp__chip { opacity: 1; transform: none; }
  @media (hover: none) { .sk-cp__chips { display: none; } }
  .sk-cp__cta { position: absolute; right: 22px; bottom: 22px; z-index: 3; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection panels (hover)",
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "image_picker", "id": "bg_image", "label": "Panel background image (default: studio backdrop)" },
    { "type": "select", "id": "title_font", "label": "Title font", "default": "Protest Riot", "options": [
      { "value": "Protest Riot", "label": "Protest Riot" }, { "value": "Caveat Brush", "label": "Caveat Brush" }, { "value": "Permanent Marker", "label": "Permanent Marker" }, { "value": "Quicksand", "label": "Quicksand" }, { "value": "Bricolage Grotesque", "label": "Bricolage Grotesque" }
    ] }
  ],
  "blocks": [
    {
      "type": "panel", "name": "Panel", "limit": 2,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Style meets confidence" },
        { "type": "text", "id": "title", "label": "Title", "default": "Shop Men" },
        { "type": "image_picker", "id": "image", "label": "Main image (PNG with transparent background works best)" },
        { "type": "image_picker", "id": "image_hover", "label": "Second image (appears on hover)" },
        { "type": "textarea", "id": "features", "label": "Hover chips (one per line: Label|icon)", "info": "Icons: check, person, hand-heart, wind, feather, hand-leaf, dress, waves, magnet", "default": "Proper Fit|check
Comfort Fit Style|person
Easy Care|hand-heart
Wind Resistant|wind
Lightweight Material|feather" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover The Edit" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "bg", "label": "Background tint", "default": "#d3d9de" },
        { "type": "color", "id": "fg", "label": "Text", "default": "#000000" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Collection panels (hover)", "blocks": [{ "type": "panel" }, { "type": "panel", "settings": { "eyebrow": "Elevate your style", "title": "Shop Women", "features": "Soft Touch\nRelaxed Fit\nEveryday Layering", "link_label": "Browse All Styles" } }] }]
}
{% endschema %}
