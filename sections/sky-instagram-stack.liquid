{%- assign s = section.settings -%}
<sky-scatter class="sk-ig" style="--ig-bg: {{ s.bg }}; --ig-fg: {{ s.fg }};" data-speed="{{ s.speed }}" data-pause="{{ s.pause_on_hover }}" data-gap="{{ s.gap }}">
  <div class="sk-container sk-ig__head">
    <h2 class="sk-ig__title" data-sk-words>{{ s.heading }}</h2>
    <p class="sk-ig__text" data-sk-reveal>{{ s.text }}</p>
  </div>

  <div class="sk-ig__viewport" data-viewport>
    <div class="sk-ig__track" data-track>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="sk-ig__card" data-card {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <img src="{{ b.image | image_url: width: 700 }}" alt="{{ b.image.alt | escape }}" width="700" height="{{ 700 | divided_by: b.image.aspect_ratio | round }}" loading="lazy" draggable="false">
          {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}
          <figcaption class="sk-ig__prods">
            {%- for pr in (1..3) -%}
              {%- assign key = 'product_' | append: pr -%}
              {%- assign p = b[key] -%}
              {%- if p != blank -%}
                <a href="{{ p.url }}" title="{{ p.title | escape }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 90 }}" alt="{{ p.title | escape }}" width="30" height="30" loading="lazy" draggable="false">{%- endif -%}</a>
              {%- endif -%}
            {%- endfor -%}
          </figcaption>
          {%- if b.link != blank -%}<a class="sk-ig__open" href="{{ b.link }}" target="_blank" rel="noopener" aria-label="Open post"></a>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</sky-scatter>

{% stylesheet %}
  sky-scatter { display: block; background: var(--ig-bg, #000); color: var(--ig-fg, #fff); overflow: hidden; padding: 70px 0 80px; }
  .sk-ig__head { display: grid; justify-items: center; text-align: center; gap: 16px; }
  .sk-ig__title { color: var(--ig-fg, #fff); font-size: clamp(34px, 5vw, 64px); font-weight: 500; }
  .sk-ig__text { max-width: 340px; font-size: 14px; }
  .sk-ig__viewport { position: relative; width: 100%; margin-top: 44px; overflow: hidden; }
  .sk-ig__track { position: relative; width: 100%; height: var(--ig-h, 360px); }
  .sk-ig__card { position: absolute; left: 0; top: 0; width: var(--ig-w, 270px); height: var(--ig-h, 360px); margin: 0; border-radius: 12px; overflow: hidden; background: #222; box-shadow: 0 18px 36px rgba(0,0,0,.4); will-change: transform; transform-origin: 50% 100%; user-select: none; }
  .sk-ig__card img, .sk-ig__card .sk-ph { width: 100%; height: 100%; object-fit: cover; }
  .sk-ig__prods { position: absolute; left: 10px; bottom: 10px; display: flex; }
  .sk-ig__prods a { width: 32px; height: 32px; margin-right: -8px; border-radius: 50%; overflow: hidden; border: 2px solid #fff; background: #fff; }
  .sk-ig__prods img { width: 100%; height: 100%; object-fit: cover; }
  .sk-ig__open { position: absolute; inset: 0 0 48px 0; }
  @media (max-width: 749px) { sky-scatter { padding: 44px 0 50px; } }
{% endstylesheet %}

{% javascript %}
  class SkyScatter extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var self = this;
      this.vp = this.querySelector('[data-viewport]');
      this.track = this.querySelector('[data-track]');
      this.cards = [].slice.call(this.querySelectorAll('[data-card]'));
      this.n = this.cards.length;
      if (!this.n) return;
      this.state = 'stack';           /* stack -> scatter -> loop */
      this.off = 0; this.paused = false;
      this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.measure();
      this.layoutStack();
      window.addEventListener('resize', function () { self.measure(); if (self.state === 'stack') self.layoutStack(); else self.layoutRow(0); });

      if (this.dataset.pause === 'true') {
        this.vp.addEventListener('mouseenter', function () { self.paused = true; });
        this.vp.addEventListener('mouseleave', function () { self.paused = false; });
      }
      /* open automatically once the whole card area is on screen (no click needed) */
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting && self.state === 'stack') { io.disconnect(); self.scatter(); } });
      }, { threshold: 0.9 });
      io.observe(this.vp);
      this.io = io;
    }
    measure() {
      var vw = this.vp.clientWidth, w = vw < 750 ? Math.min(210, vw * 0.56) : Math.min(290, vw * 0.22);
      this.cw = w; this.ch = Math.round(w * 4 / 3);
      this.gap = +this.dataset.gap || 20;
      this.step = this.cw + this.gap;
      this.style.setProperty('--ig-w', this.cw + 'px'); this.style.setProperty('--ig-h', this.ch + 'px');
      /* make sure the loop is long enough to cover the screen: clone cards if needed */
      var need = Math.ceil(vw / this.step) + 2;
      if (!this.cloned) { this.originals = this.cards.slice(); }
      var guard = 0;
      while (this.cards.length < need && guard++ < 6) {
        for (var i = 0; i < this.originals.length; i++) { var c = this.originals[i].cloneNode(true); c.setAttribute('data-clone', ''); c.setAttribute('aria-hidden', 'true'); this.track.appendChild(c); this.cards.push(c); }
        this.cloned = true;
      }
      this.total = this.cards.length * this.step;
    }
    layoutStack() {
      var cx = (this.vp.clientWidth - this.cw) / 2;
      this.cards.forEach(function (c, i) {
        var k = Math.min(i, 5);
        c.style.transition = 'none';
        c.style.zIndex = String(50 - i);
        c.style.opacity = i > 5 ? '0' : '1';
        c.style.transform = 'translate3d(' + (cx + k * 15) + 'px,' + (k * 4) + 'px,0) rotate(' + (k * 4) + 'deg) scale(' + (1 - k * 0.012).toFixed(3) + ')';
      }, this);
    }
    pos(i) {
      var x = i * this.step + this.off;
      var m = ((x % this.total) + this.total) % this.total;      /* wrap into [0, total) */
      return m - this.step;                                       /* start one card off-screen on the left */
    }
    layoutRow(delay) {
      var self = this;
      this.cards.forEach(function (c, i) {
        c.style.transition = 'transform .6s cubic-bezier(.2,.7,.2,1) ' + (delay ? i * 40 : 0) + 'ms, opacity .4s';
        c.style.opacity = '1';
        c.style.transform = 'translate3d(' + self.pos(i) + 'px,0,0) rotate(0deg) scale(1)';
      });
    }
    scatter() {
      var self = this;
      this.state = 'scatter';
      this.off = (this.vp.clientWidth - this.cw) / 2 - 0 * this.step;
      /* start the row so the first card sits at the left edge area, like the demo */
      this.off = this.gap;
      this.layoutRow(true);
      var wait = 600 + Math.min(this.cards.length, 10) * 40 + 100;
      setTimeout(function () { self.startLoop(); }, this.reduce ? 0 : wait);
    }
    startLoop() {
      var self = this;
      this.state = 'loop';
      this.cards.forEach(function (c) { c.style.transition = 'none'; });
      if (this.reduce) return;
      var last = performance.now();
      var speed = (+this.dataset.speed || 3) * 18;     /* px per second */
      (function frame(t) {
        var dt = Math.min(64, t - last); last = t;
        if (!self.paused && self.isConnected) {
          self.off -= speed * dt / 1000;                 /* right-to-left */
          for (var i = 0; i < self.cards.length; i++) self.cards[i].style.transform = 'translate3d(' + self.pos(i).toFixed(1) + 'px,0,0)';
        }
        if (self.isConnected) requestAnimationFrame(frame);
      })(last);
    }
  }
  if (!customElements.get('sky-scatter')) customElements.define('sky-scatter', SkyScatter);
{% endjavascript %}

{% schema %}
{
  "name": "Instagram / UGC",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover More on Instagram" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover trending outfits and stylish picks loved by our fashion community." },
    { "type": "range", "id": "speed", "label": "Slide speed", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "post", "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "url", "id": "link", "label": "Instagram post link (optional)" },
        { "type": "product", "id": "product_1", "label": "Product worn 1" },
        { "type": "product", "id": "product_2", "label": "Product worn 2" },
        { "type": "product", "id": "product_3", "label": "Product worn 3" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Instagram / UGC", "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }] }]
}
{% endschema %}
