{%- assign s = section.settings -%}
<sky-tabs class="sk-pt sk-section" style="--sk-pt: {{ s.pt }}px; --sk-pb: {{ s.pb }}px; --cols: {{ s.columns }};">
  <div class="sk-container sk-pt__head">
    <h2 class="sk-h2" data-sk-words>{{ s.heading }}</h2>
    <div class="sk-pt__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="sk-pt__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    <div class="sk-pt__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index0 }}" role="tabpanel">
      <ul class="sk-pt__grid">
        {%- for product in block.settings.collection.products limit: s.limit -%}
          {%- assign badge = block.settings.label | default: block.settings.collection.title -%}
          <li>{% render 'sky-product-card', product: product, badge: badge, show_swatches: true %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}<li><div class="sk-card"><div class="sk-card__media">{{ 'product-2' | placeholder_svg_tag: 'sk-ph' }}</div><div class="sk-card__info"><span class="sk-card__title">Example product</span><span class="sk-card__price">$99.00</span></div></div></li>{%- endfor -%}
        {%- endfor -%}
      </ul>
      {%- if s.show_view_all and block.settings.collection != blank -%}
        <div class="sk-container sk-pt__more"><a class="sk-btn sk-btn--dark" href="{{ block.settings.collection.url }}"><span>View all</span><span class="sk-btn__icon"><svg viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M1 7l6-6M2 1h5v5"/></svg><svg viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M1 7l6-6M2 1h5v5"/></svg></span></a></div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</sky-tabs>

{% stylesheet %}
  .sk-pt__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 28px; }
  .sk-pt__tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .sk-pt__tab { height: 40px; padding: 0 20px; border: 1px solid var(--sk-line); border-radius: 999px; background: #fff; font-size: 14px; font-weight: 500; transition: background .25s, color .25s; }
  .sk-pt__tab.is-active { background: #000; color: #fff; border-color: #000; }
  .sk-pt__panel { display: none; }
  .sk-pt__panel.is-active { display: block; animation: sk-fade .5s ease; }
  @keyframes sk-fade { from { opacity: 0; transform: translateY(14px); } }
  .sk-pt__grid { display: grid; grid-template-columns: repeat(var(--cols, 4), 1fr); border-top: 1px solid var(--sk-line); border-bottom: 1px solid var(--sk-line); }
  .sk-pt__grid li { border-bottom: 1px solid var(--sk-line); min-width: 0; }
  @media (max-width: 989px) { .sk-pt__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 599px) { .sk-pt__grid { grid-template-columns: repeat(2, 1fr); } }
  .sk-pt__more { display: flex; justify-content: center; margin-top: 28px; }
{% endstylesheet %}

{% javascript %}
  class SkyTabs extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var tabs = this.querySelectorAll('[data-tab]'), panels = this.querySelectorAll('[data-panel]');
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          var i = t.dataset.tab;
          tabs.forEach(function (x) { var on = x === t; x.classList.toggle('is-active', on); x.setAttribute('aria-selected', on); });
          panels.forEach(function (p) { p.classList.toggle('is-active', p.dataset.panel === i); });
        });
      });
    }
  }
  if (!customElements.get('sky-tabs')) customElements.define('sky-tabs', SkyTabs);
{% endjavascript %}

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh picks just dropped" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 20, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab", "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab name", "default": "Premium" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Product tabs", "blocks": [{ "type": "tab", "settings": { "label": "Premium" } }, { "type": "tab", "settings": { "label": "Fresh Picks" } }, { "type": "tab", "settings": { "label": "Trending" } }] }]
}
{% endschema %}
