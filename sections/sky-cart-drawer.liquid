{{ 'sky-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign t1 = section.settings.tier1_qty
  assign t2 = section.settings.tier2_qty
  assign t3 = section.settings.tier3_qty
-%}

<div class="sk-cd" id="SkyCartDrawer" role="dialog" aria-modal="true" aria-labelledby="sk-cd-title" aria-hidden="true">
  <div class="sk-cd__overlay" data-cd-close></div>
  <div class="sk-cd__panel">
    <div class="sk-cd__head">
      <div class="sk-cd__title-row">
        <span class="sk-cd__title" id="sk-cd-title">{{ section.settings.heading }}</span>
        <button type="button" class="sk-cd__close" data-cd-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18.75 5.13 5.25 18.85M5.25 5.13l13.5 13.72" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="sk-cd__offer" data-cd-offer></div>
    </div>
    <div class="sk-cd__body" data-cd-body data-lenis-prevent>
      <div class="sk-cd__items" data-cd-items></div>
      {%- if section.settings.show_note -%}
        <div class="sk-cd__acc" data-cd-acc>
          <details>
            <summary><span>{{ section.settings.note_label }}</span><svg class="sk-cd__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
            <textarea data-cd-note placeholder="{{ section.settings.note_placeholder | escape }}"></textarea>
          </details>
        </div>
      {%- endif -%}
    </div>
    <div class="sk-cd__empty" data-cd-empty>
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      <div class="sk-cd__empty-title">{{ section.settings.empty_text }}</div>
      <a class="sk-cd__btn sk-cd__btn--fill" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">{{ section.settings.continue_label }}</a>
    </div>
    <div class="sk-cd__foot" data-cd-foot>
      <div class="sk-cd__total"><span>{{ section.settings.total_label }}</span><span data-cd-total></span></div>
      <p class="sk-cd__note">{{ section.settings.disclaimer }}</p>
      <form class="sk-cd__actions" action="{{ routes.cart_url }}" method="post">
        <a class="sk-cd__btn sk-cd__btn--line" href="{{ routes.cart_url }}">{{ section.settings.view_cart_label }}</a>
        <button type="submit" name="checkout" class="sk-cd__btn sk-cd__btn--fill">{{ section.settings.checkout_label }}</button>
      </form>
    </div>
  </div>
</div>

<script type="application/json" data-cd-config>
{
  "offer": {{ section.settings.offer_enabled | json }},
  "tiers": [
    {%- assign first = true -%}
    {%- if t1 > 0 -%}{%- unless first -%},{%- endunless -%}{"qty": {{ t1 }}, "label": {{ section.settings.tier1_label | json }}}{%- assign first = false -%}{%- endif -%}
    {%- if t2 > 0 -%}{%- unless first -%},{%- endunless -%}{"qty": {{ t2 }}, "label": {{ section.settings.tier2_label | json }}}{%- assign first = false -%}{%- endif -%}
    {%- if t3 > 0 -%}{%- unless first -%},{%- endunless -%}{"qty": {{ t3 }}, "label": {{ section.settings.tier3_label | json }}}{%- assign first = false -%}{%- endif -%}
  ],
  "textProgress": {{ section.settings.text_progress | json }},
  "textStart": {{ section.settings.text_start | json }},
  "textDone": {{ section.settings.text_done | json }},
  "removeLabel": {{ 'Remove' | json }}
}
</script>
<script src="{{ 'sky-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "header", "content": "Drawer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true },
    { "type": "text", "id": "note_label", "label": "Order note label", "default": "Order note" },
    { "type": "text", "id": "note_placeholder", "label": "Order note placeholder", "default": "Write instructions or gift messages here..." },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Estimated total" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Taxes, discounts and shipping calculated at checkout." },
    { "type": "text", "id": "view_cart_label", "label": "View cart button", "default": "View cart" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Go to checkout" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_url", "label": "Continue shopping link" },

    { "type": "header", "content": "Offer progress bar (buy more, save more)" },
    { "type": "paragraph", "content": "The bar counts the total number of items in the cart. Create the matching automatic discount in Shopify admin (for example 2 items = 300 off, 3 items = 600 off); this bar only shows the progress." },
    { "type": "checkbox", "id": "offer_enabled", "label": "Show offer bar", "default": true },
    { "type": "range", "id": "tier1_qty", "min": 0, "max": 10, "step": 1, "label": "Goal 1: items needed (0 = off)", "default": 2 },
    { "type": "text", "id": "tier1_label", "label": "Goal 1: label", "default": "₹300 OFF" },
    { "type": "range", "id": "tier2_qty", "min": 0, "max": 10, "step": 1, "label": "Goal 2: items needed (0 = off)", "default": 3 },
    { "type": "text", "id": "tier2_label", "label": "Goal 2: label", "default": "₹600 OFF" },
    { "type": "range", "id": "tier3_qty", "min": 0, "max": 10, "step": 1, "label": "Goal 3: items needed (0 = off)", "default": 0 },
    { "type": "text", "id": "tier3_label", "label": "Goal 3: label", "default": "₹900 OFF" },
    { "type": "text", "id": "text_start", "label": "Text when cart is empty", "default": "Add {count} items to unlock {offer}" },
    { "type": "text", "id": "text_progress", "label": "Text while in progress", "info": "Use {count} for items still needed and {offer} for the next goal label.", "default": "Add {count} more to unlock {offer}" },
    { "type": "text", "id": "text_done", "label": "Text when all goals are unlocked", "default": "Congratulations! You unlocked {offer}" }
  ]
}
{% endschema %}
