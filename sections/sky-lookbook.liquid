{%- assign s = section.settings -%}
{%- assign n = section.blocks.size -%}
<div class="sk-lb-wrap" style="--lb-bg: {{ s.bg }}; --lb-aside: {{ s.bg_aside }}; padding-top: {{ s.pt }}px; padding-bottom: {{ s.pb }}px;">
<sky-lookbook class="sk-lb" data-count="{{ n }}">
  <div class="sk-lb__pin">
    <div class="sk-lb__left">
      <header class="sk-lb__head">
        <h2 class="sk-lb__title" data-sk-words>{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text | newline_to_br }}</p>{%- endif -%}
      </header>
      <div class="sk-lb__track" data-track>
        {%- for block in section.blocks reversed -%}
          {%- assign b = block.settings -%}
          <figure class="sk-lb__img" data-index="{{ forloop.rindex0 }}" style="--o: {{ forloop.rindex0 }}" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 900 }}" alt="{{ b.image.alt | default: s.heading | escape }}" width="900" height="{{ 900 | divided_by: b.image.aspect_ratio | round }}" loading="lazy">
            {%- else -%}{{ 'hero-apparel-3' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
    <aside class="sk-lb__right" data-right>
      <div class="sk-lb__prods" data-prods>
        {%- if s.collection != blank -%}
          {%- for p in s.collection.products limit: s.limit -%}{%- render 'sky-lookbook-card', product: p -%}{%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}{%- render 'sky-lookbook-card', product: block.settings.product -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </aside>
  </div>
</sky-lookbook>
</div>

{% stylesheet %}
  .sk-lb-wrap { background: var(--lb-bg, #e2e9ed); }
  sky-lookbook { display: block; position: relative; }
  .sk-lb__pin { position: sticky; top: 0; height: 100vh; height: 100dvh; display: flex; align-items: center; overflow: hidden; }
  .sk-lb__left { position: relative; flex: 1 1 auto; min-width: 0; height: 100%; overflow: hidden; }
  .sk-lb__head { position: absolute; z-index: 3; top: 75px; left: 0; right: 0; padding: 0 30px; pointer-events: none; }
  .sk-lb__title { font-family: var(--sk-font-head); font-size: 42px; line-height: 50.4px; font-weight: 600; letter-spacing: -.4px; color: #000; }
  .sk-lb__head p { margin: 14px 0 0; font-size: 14px; line-height: 21px; color: #000; }
  .sk-lb__track { --lb-gap: 10px; position: relative; width: 100%; height: 100%; display: flex; gap: var(--lb-gap); justify-content: flex-end; align-items: center; }
  .sk-lb__img { flex: 0 0 33%; min-width: 0; margin: 0; }
  .sk-lb__img img, .sk-lb__img .sk-ph { display: block; width: 100%; height: auto; object-fit: cover; }
  .sk-lb__right { flex: 0 0 300px; width: 300px; height: 100%; max-height: 100%; overflow: hidden; box-shadow: -10px 0 38px rgba(0,0,0,.12); z-index: 1; position: relative; }
  @media (min-width: 1200px) { .sk-lb__right { flex-basis: 350px; width: 350px; } }
  .sk-lb__prods { position: relative; padding: 20px; background: var(--lb-aside, #c6cdd2); will-change: transform; }
  .sk-lb__right::before, .sk-lb__right::after { content: ""; position: absolute; left: 0; width: 100%; height: 47px; z-index: 2; pointer-events: none; }
  .sk-lb__right::before { top: 0; background: linear-gradient(180deg, var(--lb-aside, #c6cdd2), transparent); }
  .sk-lb__right::after { bottom: 0; background: linear-gradient(0deg, var(--lb-aside, #c6cdd2), transparent); }
  .sk-lb__card { position: relative; margin: 10px 0; background: #fff; border: .8px solid rgba(255,255,255,.08); border-radius: 20px; overflow: hidden; }
  .sk-lb__cmedia { position: relative; aspect-ratio: 1; overflow: hidden; background: #f2f2f4; }
  .sk-lb__cmedia > a { display: block; width: 100%; height: 100%; }
  .sk-lb__cmedia img, .sk-lb__cmedia .sk-ph { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .sk-lb__card:hover .sk-lb__cmedia img { transform: scale(1.03); }
  .sk-lb__qv { position: absolute; z-index: 3; top: 20px; right: 20px; width: 35px; height: 35px; padding: 0; border: 0; border-radius: 50%; background: #fff; color: #000; display: grid; place-items: center; cursor: pointer; transition: background .3s, color .3s, transform .54s cubic-bezier(.4,0,.2,1), opacity .54s cubic-bezier(.4,0,.2,1); }
  .sk-lb__qv svg { width: 16px; height: 16px; } .sk-lb__qv:hover { background: #000; color: #fff; }
  .sk-lb__sw { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; font-size: 12px; background: rgba(255,255,255,.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transform: translateY(100%); transition: transform .45s cubic-bezier(.4,0,.2,1); }
  .sk-lb__dots { display: flex; gap: 6px; } .sk-lb__dot { width: 12px; height: 12px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0,0,0,.15); }
  .sk-lb__cinfo { padding: 15px 20px; }
  .sk-lb__ctitle { display: block; font-size: 12px; line-height: 16.2px; color: #000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sk-lb__cbottom { position: relative; margin-top: 4px; min-height: 21px; }
  .sk-lb__cprice { display: block; font-size: 14px; line-height: 21px; font-weight: 700; color: #000; transition: opacity .3s; }
  .sk-lb__cprice s { margin-left: 6px; font-weight: 400; opacity: .5; font-size: 12px; }
  .sk-lb__choose { position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; height: 21px; padding: 0 0 0 12px; isolation: isolate; border: 0; background: none; font: inherit; font-size: 14px; color: #000; cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .3s, transform .3s, visibility .3s; }
  .sk-lb__choose i { position: absolute; left: 0; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: #ff3c02; z-index: -1; transition: left .3s; }
  .sk-lb__choose:hover { padding: 0 10px 0 0; }
  .sk-lb__choose:hover i { left: calc(100% - 6px); }
  @media (hover: hover) {
    .sk-lb__qv { opacity: 0; visibility: hidden; transform: translateX(100%) scale(.8); }
    .sk-lb__card:hover .sk-lb__qv, .sk-lb__card:focus-within .sk-lb__qv { opacity: 1; visibility: visible; transform: none; }
    .sk-lb__card:hover .sk-lb__sw { transform: none; }
    .sk-lb__card:hover .sk-lb__cprice, .sk-lb__card:focus-within .sk-lb__cprice { opacity: 0; }
    .sk-lb__card:hover .sk-lb__choose, .sk-lb__card:focus-within .sk-lb__choose { opacity: 1; visibility: visible; transform: none; }
  }
  @media (max-width: 1024px) {
    .sk-lb__pin { position: static; height: auto; display: block; overflow: visible; padding: 40px 0 30px; }
    .sk-lb__left { height: auto; overflow: visible; }
    .sk-lb__head { position: static; padding: 0 20px 20px; }
    .sk-lb__title { font-size: 32px; line-height: 38px; }
    .sk-lb__track { height: auto; justify-content: flex-start; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 20px; scrollbar-width: none; align-items: flex-start; }
    .sk-lb__track::-webkit-scrollbar { display: none; }
    .sk-lb__img { flex: 0 0 62%; order: var(--o); scroll-snap-align: start; }
    .sk-lb__right { flex: none; width: auto; height: auto; box-shadow: none; overflow: visible; margin-top: 24px; }
    .sk-lb__right::before, .sk-lb__right::after { display: none; }
    .sk-lb__prods { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 12px 20px; background: transparent; scrollbar-width: none; }
    .sk-lb__prods::-webkit-scrollbar { display: none; }
    .sk-lb__card { flex: 0 0 62%; margin: 0; scroll-snap-align: start; }
    .sk-lb__qv, .sk-lb__sw { display: none; }
    .sk-lb__choose { position: static; opacity: 1; visibility: visible; transform: none; }
    .sk-lb__cbottom { min-height: 0; } .sk-lb__cprice { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  class SkyLookbook extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var self = this, track = this.querySelector('[data-track]'), right = this.querySelector('[data-right]'), prods = this.querySelector('[data-prods]');
      var imgs = [].slice.call(this.querySelectorAll('.sk-lb__img')), n = imgs.length, VISIBLE = 4, STEP = 5, MAX = 33, MIN = MAX - STEP * (VISIBLE - 1);
      var scrollDistance = 1, rightOverflow = 0, on = false;
      function lerp(stops, x) {
        if (x <= stops[0][0]) return stops[0][1]; if (x >= stops[stops.length - 1][0]) return stops[stops.length - 1][1];
        for (var i = 0; i < stops.length - 1; i++) { var a = stops[i], b = stops[i + 1]; if (x >= a[0] && x <= b[0]) return a[1] + (b[1] - a[1]) * (x - a[0]) / (b[0] - a[0]); }
        return 1;
      }
      var OP = [[18, .3], [21, .3], [24, .35], [27, .5], [30, .6], [33, 1]], BL = [[18, 3.5], [21, 3], [24, 2], [27, 1], [30, 0], [33, 0]];
      function desktop() { return window.innerWidth > 1024; }
      function total() { return n > 1 ? imgs[n - 1].offsetLeft - imgs[0].offsetLeft : 0; }
      function reset() {
        self.style.height = ''; track.style.transform = ''; prods.style.transform = '';
        imgs.forEach(function (el) { el.style.flex = ''; el.style.opacity = ''; el.style.zIndex = ''; var i = el.querySelector('img, svg'); if (i) i.style.filter = ''; });
      }
      function measure() {
        if (!desktop()) { on = false; reset(); return; }
        on = true;
        rightOverflow = Math.max(0, prods.scrollHeight - right.clientHeight);
        scrollDistance = Math.max(rightOverflow, total(), 1);
        self.style.height = (scrollDistance + window.innerHeight) + 'px';
        update();
      }
      function update() {
        if (!on) return;
        var top = self.getBoundingClientRect().top, p = top > 0 ? 0 : Math.min(1, Math.max(0, -top / scrollDistance));
        var travel = p * Math.max(n - 1, 1), tx = p * total();
        imgs.forEach(function (el) {
          var rank = (+el.dataset.index) - travel;
          if (rank > VISIBLE + 1) { el.style.flex = '0 0 ' + MIN + '%'; el.style.opacity = 0; el.style.pointerEvents = 'none'; return; }
          var f = rank < 0 ? MAX : Math.max(MIN, MAX - rank * STEP);
          el.style.flex = '0 0 ' + f + '%'; el.style.opacity = lerp(OP, f); el.style.pointerEvents = '';
          var i = el.querySelector('img, svg'); if (i) i.style.filter = 'blur(' + lerp(BL, f) + 'px)';
          el.style.zIndex = String(VISIBLE - Math.round(Math.max(0, Math.min(rank, VISIBLE - 1))));
        });
        track.style.transform = 'translate3d(' + tx + 'px,0,0)';
        prods.style.transform = 'translate3d(0,' + (-p * rightOverflow) + 'px,0)';
      }
      Sky.onScroll(update);
      window.addEventListener('resize', measure);
      window.addEventListener('load', measure);
      [].forEach.call(this.querySelectorAll('img'), function (im) { if (!im.complete) im.addEventListener('load', measure); });
      measure();
    }
  }
  if (!customElements.get('sky-lookbook')) customElements.define('sky-lookbook', SkyLookbook);
{% endjavascript %}

{% schema %}
{
  "name": "Lookbook (pinned scroll)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spring Summer 2026" },
    { "type": "textarea", "id": "text", "label": "Text (new line = line break)", "default": "Every piece of clothing is made to bring effortless style to everyday\nmoments. From relaxed essentials to standout layers, our collections\nare designed for modern living." },
    { "type": "header", "content": "Products (right column)" },
    { "type": "collection", "id": "collection", "label": "Collection (blank = products set on each look)" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 2, "max": 20, "step": 1, "default": 10 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#e2e9ed" },
    { "type": "color", "id": "bg_aside", "label": "Product column background", "default": "#c6cdd2" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "look", "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (2:3 portrait works best)" },
        { "type": "product", "id": "product", "label": "Product (used if no collection is set)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Lookbook (pinned scroll)", "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
