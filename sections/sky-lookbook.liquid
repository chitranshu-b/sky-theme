{%- assign s = section.settings -%}
{%- assign n = section.blocks.size -%}
<sky-lookbook class="sk-lb" style="--lb-steps: {{ n | times: 0.7 | plus: 1.2 }}; --lb-bg: {{ s.bg }};" data-count="{{ n }}">
  <div class="sk-lb__stage">
    <div class="sk-lb__main">
      <header class="sk-lb__head">
        <h2 class="sk-lb__title">{{ s.heading }}</h2>
        <p>{{ s.text }}</p>
      </header>
      <div class="sk-lb__track" data-track>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <figure class="sk-lb__look{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 700 }}" alt="{{ b.image.alt | escape }}" width="700" height="{{ 700 | divided_by: b.image.aspect_ratio | round }}" loading="lazy">
            {%- else -%}{{ 'hero-apparel-3' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>

    <aside class="sk-lb__aside">
      <div class="sk-lb__col" data-col>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a class="sk-lb__prod" href="{{ p.url }}" data-i="{{ forloop.index0 }}">
              <span class="sk-lb__pimg">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}" width="500" height="{{ 500 | divided_by: p.featured_image.aspect_ratio | round }}" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}</span>
              <span class="sk-lb__pt">{{ p.title }}</span>
              <span class="sk-lb__pp">{{ p.price | money }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </aside>
  </div>
</sky-lookbook>

{% stylesheet %}
  sky-lookbook { display: block; position: relative; height: calc(var(--lb-steps) * 100vh); background: var(--lb-bg, #dfe5ea); }
  .sk-lb__stage { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; grid-template-columns: 1fr minmax(220px, 26%); }
  .sk-lb__main { position: relative; overflow: hidden; padding: 12vh 0 0 var(--sk-gutter); }
  .sk-lb__head { position: relative; z-index: 3; max-width: 520px; display: grid; gap: 14px; font-size: 14px; }
  .sk-lb__title { font-size: clamp(30px, 3.6vw, 46px); font-weight: 500; }
  .sk-lb__track { position: absolute; left: 0; bottom: 8vh; display: flex; align-items: flex-end; gap: 4vw; padding-left: var(--sk-gutter); will-change: transform; }
  .sk-lb__look { flex: 0 0 auto; margin: 0; width: clamp(130px, 17vw, 250px); filter: blur(5px); opacity: .55; transform: scale(.88); transform-origin: 50% 100%; transition: filter .5s, opacity .5s, transform .5s; }
  .sk-lb__look.is-active { filter: none; opacity: 1; transform: scale(1); }
  .sk-lb__look img, .sk-lb__look .sk-ph { width: 100%; height: auto; max-height: 56vh; object-fit: contain; object-position: bottom; mix-blend-mode: multiply; }
  .sk-lb__aside { position: relative; overflow: hidden; background: rgba(0,0,0,.08); padding: 16px; }
  .sk-lb__col { display: grid; gap: 14px; will-change: transform; }
  .sk-lb__prod { display: block; padding-bottom: 14px; border-radius: 20px; background: #fff; overflow: hidden; }
  .sk-lb__pimg { display: block; margin: 8px; border-radius: 14px; overflow: hidden; aspect-ratio: 1; background: #f4f4f6; }
  .sk-lb__pimg img, .sk-lb__pimg .sk-ph { width: 100%; height: 100%; object-fit: cover; }
  .sk-lb__pt, .sk-lb__pp { display: block; padding: 0 14px; font-size: 12px; }
  .sk-lb__pt { margin-top: 8px; } .sk-lb__pp { margin-top: 4px; font-weight: 700; font-size: 14px; }
  .sk-lb__prod.is-active { box-shadow: 0 0 0 2px #000; }
  @media (max-width: 749px) {
    .sk-lb__stage { grid-template-columns: 1fr; grid-template-rows: 1fr 34%; }
    .sk-lb__aside { padding: 10px; }
    .sk-lb__col { grid-auto-flow: column; grid-auto-columns: 46%; gap: 10px; }
  }
{% endstylesheet %}

{% javascript %}
  class SkyLookbook extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var self = this, n = +this.dataset.count || 1;
      var track = this.querySelector('[data-track]'), col = this.querySelector('[data-col]'), aside = this.querySelector('.sk-lb__aside');
      var looks = this.querySelectorAll('.sk-lb__look'), prods = this.querySelectorAll('.sk-lb__prod'), main = this.querySelector('.sk-lb__main');
      var last = -1;
      Sky.onScroll(function () {
        var p = Sky.pinProgress(self), mobile = window.innerWidth < 750;
        var trackMax = Math.max(0, track.scrollWidth - main.clientWidth + 40);
        track.style.transform = 'translateX(' + (-p * trackMax).toFixed(1) + 'px)';
        if (mobile) { var cm = Math.max(0, col.scrollWidth - aside.clientWidth + 10); col.style.transform = 'translateX(' + (-p * cm).toFixed(1) + 'px)'; }
        else { var ch = Math.max(0, col.scrollHeight - aside.clientHeight + 16); col.style.transform = 'translateY(' + (-p * ch).toFixed(1) + 'px)'; }
        var idx = Math.min(n - 1, Math.round(p * (n - 1)));
        if (idx !== last) {
          last = idx;
          looks.forEach(function (l, i) { l.classList.toggle('is-active', i === idx); });
          prods.forEach(function (c) { c.classList.toggle('is-active', +c.dataset.i === idx); });
        }
      });
    }
  }
  if (!customElements.get('sky-lookbook')) customElements.define('sky-lookbook', SkyLookbook);
{% endjavascript %}

{% schema %}
{
  "name": "Lookbook (pinned scroll)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spring Summer 2026" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every piece of clothing is made to bring effortless style to everyday moments. From relaxed essentials to standout layers, our collections are designed for modern living." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#dfe5ea" }
  ],
  "blocks": [
    {
      "type": "look", "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Model image (PNG with transparent background works best)" },
        { "type": "product", "id": "product", "label": "Product shown on the right" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Lookbook (pinned scroll)", "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
