{%- assign s = section.settings -%}
{%- assign n = section.blocks.size -%}
{%- assign ticker_items = s.ticker | replace: '•', '|' | split: '|' -%}
<div class="sk-space" style="padding-top: {{ s.pt }}px; padding-bottom: {{ s.pb }}px;">
<sky-showcase class="sk-sc" style="--n: {{ n }};" data-count="{{ n }}">

  <div class="sk-sc__banner" data-banner>
    <div class="sk-sc__bg">
      {%- if s.bg_image != blank -%}
        <img src="{{ s.bg_image | image_url: width: 2400 }}" srcset="{{ s.bg_image | image_url: width: 1200 }} 1200w, {{ s.bg_image | image_url: width: 2400 }} 2400w" sizes="100vw" alt="" width="2400" height="{{ 2400 | divided_by: s.bg_image.aspect_ratio | round }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="sk-sc__banner-in sk-container">
      <h2 class="sk-sc__heading" data-sk-words>{{ s.heading | newline_to_br }}</h2>
    </div>
  </div>

  <div class="sk-sc__wrap" data-wrap>
    <div class="sk-sc__outer">

      <div class="sk-sc__menu">
        <div class="sk-sc__menu-title">{{ s.eyebrow }}</div>
        <div class="sk-sc__list" data-list>
          <div class="sk-sc__list-in" data-list-in>
            {%- for block in section.blocks -%}
              <a href="{{ block.settings.link | default: block.settings.collection.url | default: '#' }}" class="sk-sc__item{% if forloop.first %} is-active{% endif %}" data-item {{ block.shopify_attributes }}>{{ block.settings.title | default: block.settings.collection.title }}</a>
            {%- endfor -%}
          </div>
        </div>
        {%- if ticker_items.size > 0 and s.ticker != blank -%}
          <div class="sk-sc__ticker" aria-hidden="true">
            <div class="sk-sc__ticker-in">
              {%- for i in (1..2) -%}
                <div class="sk-sc__ticker-node">
                  {%- for t in ticker_items -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<span class="sk-sc__ticker-item">{{ tt }}</span>{%- endif -%}{%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="sk-sc__images">
        <div class="sk-sc__image-list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <a href="{{ b.link | default: b.collection.url | default: '#' }}" class="sk-sc__image" data-image aria-label="{{ b.title | default: b.collection.title | escape }}" tabindex="-1">
              <div class="sk-sc__media">
                {%- if b.image != blank -%}
                  <img src="{{ b.image | image_url: width: 1600 }}" srcset="{{ b.image | image_url: width: 800 }} 800w, {{ b.image | image_url: width: 1600 }} 1600w" sizes="(min-width: 1200px) 60vw, (min-width: 1025px) 55vw, 42vw" alt="{{ b.image.alt | escape }}" width="1600" height="{{ 1600 | divided_by: b.image.aspect_ratio | round }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'sk-ph' }}
                {%- endif -%}
              </div>
              <div class="sk-sc__mob">
                <span class="sk-sc__mob-title">{{ b.title | default: b.collection.title }}</span>
                <div class="sk-sc__cardi">
                  {%- render 'sky-showcase-icon', icon: b.icon -%}
                  <div class="sk-sc__cardt">{{ b.text }}</div>
                </div>
              </div>
            </a>
          {%- endfor -%}
        </div>

        <div class="sk-sc__card" data-card>
          <div class="sk-sc__card-in" data-card-in>
            {%- for block in section.blocks -%}
              <div class="sk-sc__cardi" data-cardi>
                {%- render 'sky-showcase-icon', icon: block.settings.icon -%}
                <div class="sk-sc__cardt">{{ block.settings.text }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</sky-showcase>
</div>

{% stylesheet %}
  sky-showcase { display: block; position: relative; background: #000; color: #fff; }
  .sk-sc__banner { position: relative; display: grid; overflow: hidden; background: #000; --ho: 0; }
  .sk-sc__bg, .sk-sc__banner-in { grid-area: 1 / -1; }
  .sk-sc__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-sc__banner::after { content: ""; position: absolute; inset: 0; background: #000; opacity: var(--ho); pointer-events: none; }
  .sk-sc__banner-in { position: relative; z-index: 1; display: flex; flex-direction: column; padding-block: 60px 80px; }
  .sk-sc__heading { color: #fff; font-size: 37.7px; font-weight: 600; line-height: 1.2; }
  @media (min-width: 768px) { .sk-sc__heading { font-size: 51.5px; } }
  @media (min-width: 1025px) { .sk-sc__heading { font-size: 72px; } .sk-sc__banner-in { padding-block: 100px; } }

  .sk-sc__wrap { position: relative; padding-inline: 0; }
  .sk-sc__outer { padding-block: 0 40px; }

  .sk-sc__menu { display: none; }
  .sk-sc__card { display: none; }
  .sk-sc__images { position: relative; }
  .sk-sc__image-list { display: flex; gap: 10px; padding-inline: var(--sk-gutter); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .sk-sc__image-list::-webkit-scrollbar { display: none; }
  .sk-sc__image { position: relative; flex: 0 0 42%; scroll-snap-align: start; display: block; aspect-ratio: 2 / 3; border-radius: 15px; overflow: hidden; background: #111; color: #fff; }
  @media (min-width: 768px) { .sk-sc__image { flex-basis: calc((100% - 2 * var(--sk-gutter) - 20px) / 3); } }
  .sk-sc__media, .sk-sc__media img, .sk-sc__media .sk-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sk-sc__mob { position: absolute; left: 0; right: 0; bottom: 0; padding: 10px; display: grid; gap: 10px; text-align: center; }
  .sk-sc__mob-title { font-family: var(--sk-font-head); font-size: 20px; font-weight: 600; line-height: 1.2; text-shadow: 0 1px 10px rgba(0,0,0,.35); }
  .sk-sc__mob .sk-sc__cardi { display: flex; flex-direction: column; justify-content: space-between; gap: 20px; padding: 20px; text-align: left; border-radius: 15px; background: rgba(103,103,103,.3); -webkit-backdrop-filter: blur(15px); backdrop-filter: blur(15px); }
  .sk-sc__mob .sk-sc__ico { width: 30px; }
  .sk-sc__cardt { font-size: 14px; line-height: 1.3; }
  @media (min-width: 768px) { .sk-sc__cardt { font-size: 16px; line-height: 1.5; } }
  .sk-sc__ico { display: block; width: 60px; height: 60px; }
  .sk-sc__ico img, .sk-sc__ico svg { width: 100%; height: 100%; object-fit: contain; aspect-ratio: 1; }

  @media (min-width: 1025px) {
    sky-showcase { height: calc((var(--n) + 1.5) * 100vh); height: calc((var(--n) + 1.5) * 100dvh); }
    .sk-sc__banner { position: sticky; top: 0; height: 100vh; height: 100dvh; }
    .sk-sc__wrap { position: sticky; top: 0; height: 100vh; height: 100dvh; padding-inline: var(--sk-gutter); }
    .sk-sc__outer { height: 100%; display: grid; grid-template-columns: 1fr 1.2fr; gap: 30px; padding-block: 70px; }
    .sk-sc__menu { display: grid; grid-template-rows: auto 1fr auto; padding-block: 60px 24px; border-radius: 30px; background: #fff; color: #000; min-height: 0; }
    .sk-sc__menu-title { padding-inline: 30px; text-align: center; font-family: var(--sk-font-head); font-size: 16px; font-weight: 600; line-height: 1.5; text-transform: uppercase; }
    .sk-sc__list { margin-block: auto; max-width: 100%; overflow: hidden; height: 168px; padding: 56px 30px 0; }
    .sk-sc__list-in { display: flex; flex-direction: column; text-align: center; transition: transform .6s cubic-bezier(.25,1,.5,1); will-change: transform; }
    .sk-sc__item { display: block; padding-block: 10px; font-family: var(--sk-font-head); font-size: 30px; font-weight: 600; line-height: 1.2; white-space: nowrap; color: #000; opacity: .5; transition: opacity .4s; }
    .sk-sc__item.is-active { opacity: 1; }
    .sk-sc__ticker { overflow: hidden; }
    .sk-sc__ticker-in { display: flex; width: max-content; animation: sk-sc-mq 24s linear infinite; }
    .sk-sc__ticker-node { display: flex; flex: 0 0 auto; }
    .sk-sc__ticker-item { position: relative; padding-inline: 25px; font-size: 14px; line-height: 1.5; white-space: nowrap; }
    .sk-sc__ticker-item::before { content: ""; position: absolute; left: 0; top: 50%; width: 5px; height: 5px; border-radius: 50%; background: #000; transform: translateY(-50%); }
    @keyframes sk-sc-mq { to { transform: translateX(-50%); } }
    .sk-sc__images { height: 100%; border-radius: 30px; overflow: hidden; min-height: 0; }
    .sk-sc__image-list { display: block; position: absolute; inset: 0; padding: 0; overflow: hidden; }
    .sk-sc__image { position: absolute; inset: 0; flex: none; aspect-ratio: auto; border-radius: 0; clip-path: inset(100% 0 0); backface-visibility: hidden; transform: translateZ(0); }
    .sk-sc__image:first-child { clip-path: inset(0 0 0); }
    .sk-sc__media img, .sk-sc__media .sk-ph { transform: translate3d(0, 8px, 0); will-change: transform; }
    .sk-sc__image:first-child .sk-sc__media img { transform: none; }
    .sk-sc__mob { display: none; }
    .sk-sc__card { display: block; position: absolute; z-index: 3; right: 20px; bottom: 20px; width: 100%; max-width: calc(100% - 40px); height: var(--card-h, 268px); overflow: hidden; border-radius: 30px; background: rgba(103,103,103,.3); -webkit-backdrop-filter: blur(15px); backdrop-filter: blur(15px); color: #fff; transition: height .5s cubic-bezier(.25,1,.5,1); }
    .sk-sc__card-in { transition: transform .6s cubic-bezier(.25,1,.5,1); will-change: transform; }
    .sk-sc__card .sk-sc__cardi { display: flex; flex-direction: column; justify-content: space-between; gap: 90px; padding: 30px; min-height: 250px; }
    .sk-sc__card .sk-sc__cardt { font-size: 24px; line-height: 1.2; font-weight: 400; }
  }
  @media (min-width: 1200px) {
    .sk-sc__outer { grid-template-columns: 1fr 1.5fr; }
    .sk-sc__card { max-width: 500px; }
  }
  @media (prefers-reduced-motion: reduce) { .sk-sc__ticker-in { animation: none; } }
{% endstylesheet %}

{% javascript %}
  class SkyShowcase extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var self = this;
      this.banner = this.querySelector('[data-banner]');
      this.wrap = this.querySelector('[data-wrap]');
      this.images = [].slice.call(this.querySelectorAll('[data-image]'));
      this.items = [].slice.call(this.querySelectorAll('[data-item]'));
      this.cardis = [].slice.call(this.querySelectorAll('[data-cardi]'));
      this.listIn = this.querySelector('[data-list-in]');
      this.card = this.querySelector('[data-card]');
      this.cardIn = this.querySelector('[data-card-in]');
      this.n = this.images.length;
      this.active = -1;
      this.mq = window.matchMedia('(min-width: 1025px)');
      this.measure = function () {
        self.ih = self.items.map(function (e) { return e.offsetHeight; });
        self.ch = self.cardis.map(function (e) { return e.offsetHeight; });
        self.start = self.getBoundingClientRect().top + window.scrollY + self.banner.offsetHeight;
        self.active = -1;
        self.run();
      };
      this.run = function () {
        if (!self.mq.matches) { self.reset(); return; }
        var vh = window.innerHeight, total = vh * self.n + vh * .1;
        var scrolled = Math.max(0, Math.min(window.scrollY - self.start, total));
        /* banner darkens as the cards slide over it */
        var fs = self.start - vh * .6, fr = self.start - vh * .1 - fs, op = 0;
        if (self.start > 0 && fr > 0) op = Math.min(1, Math.max(0, (window.scrollY - fs) / fr));
        self.banner.style.setProperty('--ho', op);
        for (var i = 1; i < self.n; i++) {
          var a = vh * (i - 1), b = vh * i, reveal = vh, move = 8;
          if (scrolled >= a && scrolled <= b) { var p = (scrolled - a) / vh; reveal = vh * (1 - p); move = 8 - p * 8; }
          else if (scrolled > b) { reveal = 0; move = 0; }
          self.images[i].style.clipPath = 'inset(' + reveal + 'px 0 0)';
          var im = self.images[i].querySelector('img, svg');
          if (im) im.style.transform = 'translate3d(0,' + move + 'px,0)';
        }
        var idx = Math.min(Math.floor(scrolled / vh), self.n - 1);
        if (idx !== self.active) {
          self.active = idx;
          self.items.forEach(function (e, k) { e.classList.toggle('is-active', k === idx); });
          var ty = 0, cy = 0;
          for (var j = 0; j < idx; j++) { ty += self.ih[j] || 0; cy += self.ch[j] || 0; }
          if (self.listIn) self.listIn.style.transform = 'translate3d(0,-' + ty + 'px,0)';
          if (self.cardIn) self.cardIn.style.transform = 'translate3d(0,-' + cy + 'px,0)';
          if (self.card && self.ch[idx]) self.card.style.setProperty('--card-h', self.ch[idx] + 'px');
        }
      };
      this.reset = function () {
        self.images.forEach(function (e) { e.style.clipPath = ''; var im = e.querySelector('img, svg'); if (im) im.style.transform = ''; });
        if (self.listIn) self.listIn.style.transform = '';
        if (self.cardIn) self.cardIn.style.transform = '';
        self.active = -1;
      };
      var rt;
      window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(self.measure, 150); });
      window.addEventListener('load', self.measure);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(self.measure);
      this.measure();
      (window.Sky && Sky.onScroll ? Sky.onScroll : function (f) { window.addEventListener('scroll', f, { passive: true }); f(); })(self.run);
    }
  }
  if (!customElements.get('sky-showcase')) customElements.define('sky-showcase', SkyShowcase);
{% endjavascript %}

{% schema %}
{
  "name": "Pinned collections",
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "bg_image", "label": "Banner background image (optional)" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Dress Up Your\nBeautiful Moments" },
    { "type": "header", "content": "Collections card" },
    { "type": "text", "id": "eyebrow", "label": "Small title on card", "default": "Our Collections" },
    { "type": "text", "id": "ticker", "label": "Running text at the bottom", "info": "Separate phrases with the • symbol.", "default": "Designed to Stand Out • Elevate Your Wardrobe • Timeless Fits. Modern Style." }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name (optional)", "default": "Jackets" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "icon", "label": "Icon on the text card (optional, SVG/PNG, white works best)" },
        { "type": "textarea", "id": "text", "label": "Text on image card", "default": "Stylish jackets crafted for warmth, comfort, and everyday confidence." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Pinned collections", "blocks": [{ "type": "collection" }, { "type": "collection", "settings": { "title": "Sports Wear", "text": "Classic stripes and polished knits made for everyday comfort and easy layering." } }, { "type": "collection", "settings": { "title": "Relaxed Fit", "text": "Relaxed silhouettes offering effortless comfort for every casual occasion." } }] }]
}
{% endschema %}
