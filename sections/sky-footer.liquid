{%- assign s = section.settings -%}
<div class="sk-space" style="padding-top: {{ section.settings.pt }}px; padding-bottom: {{ section.settings.pb }}px;">
<footer class="sk-ft2" style="--f-bg: {{ s.bg }}; --f-fg: {{ s.fg }};">
  <div class="sk-container sk-ft2__grid">
    <div class="sk-ft2__news">
      <h3>{{ s.news_heading }}</h3>
      <p>{{ s.news_text }}</p>
      {%- form 'customer', id: 'FooterNewsletter', class: 'sk-ft2__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sk-sr" for="FooterEmail">Email</label>
        <input id="FooterEmail" type="email" name="contact[email]" placeholder="Email" required autocomplete="email" value="{{ form.email }}">
        <button type="submit" aria-label="Subscribe"><svg width="22" height="12" viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6h19M15 1l5 5-5 5"/></svg></button>
        {%- if form.posted_successfully? -%}<p class="sk-ft2__ok">Thanks for subscribing!</p>{%- endif -%}
        {%- if form.errors -%}<p class="sk-ft2__err">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </div>

    <div class="sk-ft2__cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            <div class="sk-ft2__col" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.menu != blank -%}<ul>{%- for l in block.settings.menu.links -%}<li><a href="{{ l.url }}">{{ l.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
            </div>
          {%- when 'contact' -%}
            <div class="sk-ft2__col sk-ft2__col--contact" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <div class="sk-ft2__addr">{{ block.settings.address }}</div>
              {%- if block.settings.link_label != blank -%}<a class="sk-ft2__u" href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label }}</a>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</footer>
</div>

{% stylesheet %}
  .sk-ft2 { background: var(--f-bg, #f2f2f4); color: var(--f-fg, #202020); }
  .sk-ft2__grid { display: grid; grid-template-columns: minmax(240px, 24%) 1fr; gap: 0; padding-top: 0; padding-bottom: 0; }
  .sk-ft2__news { padding: 40px 36px 40px 0; border-right: 1px solid var(--sk-line); display: grid; gap: 12px; align-content: start; }
  .sk-ft2 h3 { font-family: var(--sk-font-body); font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--f-fg, #202020); }
  .sk-ft2__news p { font-size: 14px; max-width: 24ch; }
  .sk-ft2__form { position: relative; display: grid; grid-template-columns: 1fr auto; margin-top: 18px; border-bottom: 1px solid currentColor; }
  .sk-ft2__form input[type=email] { height: 44px; border: 0; outline: 0; background: none; font: inherit; color: inherit; }
  .sk-ft2__form button { border: 0; background: none; padding: 0 4px; }
  .sk-ft2__ok, .sk-ft2__err { position: absolute; top: 100%; left: 0; margin-top: 8px; font-size: 12px; }
  .sk-ft2__cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 40px 0 40px 36px; }
  .sk-ft2__col h3 { margin-bottom: 18px; }
  .sk-ft2__col li + li { margin-top: 10px; }
  .sk-ft2__col a { font-size: 14px; transition: opacity .25s; } .sk-ft2__col a:hover { opacity: .6; }
  .sk-ft2__addr { font-size: 14px; line-height: 1.55; } .sk-ft2__u { display: inline-block; margin-top: 14px; font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 989px) { .sk-ft2__grid { grid-template-columns: 1fr; } .sk-ft2__news { border: 0; padding: 36px 0 0; } .sk-ft2__cols { grid-template-columns: repeat(2, 1fr); padding: 28px 0 36px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Join our newsletter" },
    { "type": "text", "id": "news_text", "label": "Newsletter text", "default": "Be the first to know about new collections and exclusive offers." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f2f2f4" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#202020" }
  ],
  "blocks": [
    {
      "type": "links", "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact", "name": "Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact" },
        { "type": "textarea", "id": "address", "label": "Address", "default": "1450 Market Street,\nSuite 600 San Francisco, CA 94103\nUnited States" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Get in Touch" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Footer", "blocks": [{ "type": "links" }, { "type": "links", "settings": { "title": "Best collections" } }, { "type": "links", "settings": { "title": "Help & support" } }, { "type": "contact" }] }]
}
{% endschema %}
