{%- assign s = section.settings -%}
<sky-stl class="sk-stl" data-autoplay="{{ s.autoplay }}" style="--stl-h: {{ s.height }}px; --stl-hm: {{ s.height_m }}px; --stl-pin: {{ s.pin_color }}; --stl-pt: {{ s.pt }}px; --stl-pb: {{ s.pb }}px;">
  <div class="sk-stl__wrap">
    <div class="sk-stl__media">
      {%- if s.image != blank -%}
        {%- if s.mobile_image != blank -%}
          <picture>
            <source media="(max-width: 767px)" srcset="{{ s.mobile_image | image_url: width: 1200 }}">
            <img src="{{ s.image | image_url: width: 2400 }}" alt="{{ s.image.alt | escape }}" width="2400" height="{{ 2400 | divided_by: s.image.aspect_ratio | round }}" loading="lazy">
          </picture>
        {%- else -%}
          <img src="{{ s.image | image_url: width: 2400 }}" alt="{{ s.image.alt | escape }}" width="2400" height="{{ 2400 | divided_by: s.image.aspect_ratio | round }}" loading="lazy">
        {%- endif -%}
      {%- else -%}{{ 'hero-apparel-2' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <button type="button" class="sk-stl__hot{% if forloop.first %} is-active{% endif %}" data-hot="{{ forloop.index0 }}" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --xm: {{ block.settings.x_m | default: block.settings.x }}%; --ym: {{ block.settings.y_m | default: block.settings.y }}%;" {{ block.shopify_attributes }}>
        <span class="sk-sr">Hotspot {{ forloop.index }}</span><span class="sk-stl__pin"></span>
      </button>
    {%- endfor -%}

    <div class="sk-stl__content sk-container">
      <div class="sk-stl__top">
        <h2 class="sk-h2 sk-stl__h" data-sk-words>{{ s.heading | newline_to_br }}</h2>
        {%- if s.text != blank -%}<p class="sk-stl__text">{{ s.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
      <div class="sk-stl__bottom">
        <div class="sk-stl__prods">
          <div class="sk-stl__box">
            <div class="sk-stl__track" data-track>
              {%- for block in section.blocks -%}
                {%- assign p = block.settings.product -%}
                <div class="sk-stl__slide" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  <div class="sk-stl__card">
                    <a class="sk-stl__pimg" href="{{ p.url | default: '#' }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 450 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="225" height="300" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sk-ph' }}{%- endif -%}</a>
                    <div class="sk-stl__info">
                      <div class="sk-stl__meta">
                        <a class="sk-stl__ptitle" href="{{ p.url | default: '#' }}">{{ p.title | default: 'Choose a product' }}</a>
                        {%- if p != blank -%}<span class="sk-stl__price">{% if p.price_varies %}From {% endif %}{{ p.price | money_without_currency | prepend: '₹' }}</span>{%- endif -%}
                      </div>
                      {%- if p != blank -%}
                      <div class="sk-stl__btns">
                        <a href="{{ p.url }}" class="sk-stl__btn">View</a>
                        <button type="button" class="sk-stl__btn" data-qv="{{ p.handle }}">Shop now</button>
                      </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="sk-stl__nav">
            <div class="sk-stl__counter">
              {%- for block in section.blocks -%}
                <div class="sk-stl__ci{% if forloop.first %} is-active{% endif %}" data-ci="{{ forloop.index0 }}">
                  <span class="sk-stl__cname">{{ block.settings.title | default: s.look_name }}</span>
                  <span class="sk-stl__count"><span>{{ forloop.index }}</span> / <span>{{ section.blocks.size }}</span></span>
                </div>
              {%- endfor -%}
            </div>
            {%- if section.blocks.size > 1 -%}
              <div class="sk-stl__arrows">
                <button type="button" class="sk-stl__arrow" data-step="-1" aria-label="Previous slide"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="sk-stl__arrow" data-step="1" aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</sky-stl>

{% stylesheet %}
  sky-stl { display: block; background: #000; color: #fff; padding: var(--stl-pt, 0px) 0 var(--stl-pb, 0px); }
  .sk-stl__wrap { position: relative; display: grid; min-height: var(--stl-hm, 660px); }
  @media (min-width: 768px) { .sk-stl__wrap { min-height: var(--stl-h, 810px); } }
  .sk-stl__media, .sk-stl__content { grid-area: 1 / -1; min-width: 0; }
  .sk-stl__media { position: relative; overflow: hidden; }
  .sk-stl__media img, .sk-stl__media picture, .sk-stl__media .sk-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-stl__content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; max-width: none; margin: 0; padding: 40px 25px 25px; pointer-events: none; }
  @media (min-width: 768px) { .sk-stl__content { padding-top: 60px; } }
  .sk-stl__top, .sk-stl__bottom { pointer-events: none; }
  .sk-stl__prods { pointer-events: auto; }
  .sk-stl__h { max-width: 500px; color: #fff; font-family: "Protest Riot", var(--sk-font-head), sans-serif; font-weight: 400; letter-spacing: normal; }
  .sk-stl__text { margin-top: 15px; max-width: 520px; font-size: 14px; line-height: 21px; }

  /* hotspots */
  .sk-stl__hot { position: absolute; z-index: 2; top: var(--ym); left: var(--xm); display: inline-flex; padding: 0; border: 0; background: none; cursor: pointer; transform: translate(-50%, -50%); }
  @media (min-width: 768px) { .sk-stl__hot { top: var(--y); left: var(--x); } }
  .sk-stl__pin { display: inline-flex; width: 22px; height: 22px; border-radius: 50%; background: var(--stl-pin, #fff); }
  .sk-stl__hot::before { content: ""; position: absolute; top: -10px; left: -10px; width: 42px; height: 42px; border-radius: 50%; background: rgba(255,255,255,.38); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); z-index: -1; pointer-events: none; opacity: 0; transition: all .4s; }
  .sk-stl__hot.is-active::before { opacity: 1; animation: sk-stl-pulse 1.6s ease-in-out infinite; }
  @keyframes sk-stl-pulse { 0% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.2); opacity: .5; } 100% { transform: scale(1); opacity: 1; } }

  /* products */
  .sk-stl__prods { max-width: 470px; margin: 15px auto 0; }
  .sk-stl__box, .sk-stl__counter, .sk-stl__arrow { background: rgba(103,103,103,.3); -webkit-backdrop-filter: blur(15px); backdrop-filter: blur(15px); }
  .sk-stl__box { border-radius: 10px; overflow: hidden; }
  .sk-stl__track { display: flex; transition: transform .35s ease-out; will-change: transform; }
  .sk-stl__slide { flex: 0 0 100%; min-width: 0; }
  .sk-stl__card { display: grid; grid-template-columns: auto 1fr; height: 100%; }
  .sk-stl__pimg { display: block; width: 90px; padding: 15px; border-right: 1px solid rgba(255,255,255,.2); box-sizing: border-box; }
  .sk-stl__pimg img, .sk-stl__pimg .sk-ph { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 10px; display: block; }
  .sk-stl__info { display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding: 18px 15px; min-width: 0; }
  .sk-stl__meta { display: flex; flex-direction: column; gap: 4px; }
  .sk-stl__ptitle { font-size: 14px; line-height: 21px; color: #fff; }
  .sk-stl__price { font-size: 14px; line-height: 21px; font-weight: 700; }
  .sk-stl__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .sk-stl__btn { display: grid; place-items: center; min-width: 90px; height: 36px; padding: 4px 10px; border: .8px solid #fff; border-radius: 40px; background: transparent; color: #fff; font: inherit; font-size: 12px; line-height: 12px; text-transform: capitalize; cursor: pointer; transition: background .3s, color .3s; }
  .sk-stl__btn:hover { background: #fff; color: #000; }
  @media (min-width: 768px) {
    .sk-stl__pimg { width: 150px; padding: 20px; }
    .sk-stl__info { padding: 20px; }
  }

  .sk-stl__nav { display: flex; gap: 8px; margin-top: 6px; }
  .sk-stl__counter { position: relative; flex: 1; min-width: 0; height: 40px; border-radius: 50px; }
  .sk-stl__ci { position: absolute; inset: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 5px 20px; opacity: 0; transition: opacity .35s ease; pointer-events: none; }
  .sk-stl__ci.is-active { opacity: 1; }
  .sk-stl__cname { font-size: 14px; line-height: 21px; text-transform: uppercase; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sk-stl__count { flex: none; font-size: 12px; line-height: 16.2px; }
  .sk-stl__arrows { display: flex; gap: 8px; }
  .sk-stl__arrow { width: 62px; height: 40px; padding: 0; border: 0; border-radius: 50px; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background .3s; }
  .sk-stl__arrow:hover { background: rgba(103,103,103,.55); }
{% endstylesheet %}

{% javascript %}
  class SkyStl extends HTMLElement {
    connectedCallback() {
      if (this.ready) return; this.ready = true;
      var self = this, track = this.querySelector('[data-track]');
      var slides = this.querySelectorAll('[data-slide]'), hots = this.querySelectorAll('[data-hot]'), cis = this.querySelectorAll('[data-ci]');
      var n = slides.length, cur = 0, timer = null, ms = (+this.dataset.autoplay || 0) * 1000;
      if (!n) return;
      function go(i) {
        cur = (i + n) % n;
        track.style.transform = 'translateX(' + (-100 * cur) + '%)';
        hots.forEach(function (h, k) { h.classList.toggle('is-active', k === cur); });
        cis.forEach(function (c, k) { c.classList.toggle('is-active', k === cur); });
      }
      function play() { stop(); if (ms > 0 && n > 1) timer = setInterval(function () { go(cur + 1); }, ms); }
      function stop() { clearInterval(timer); }
      this.querySelectorAll('[data-step]').forEach(function (b) { b.addEventListener('click', function () { go(cur + +b.dataset.step); play(); }); });
      hots.forEach(function (h, i) { h.addEventListener('click', function () { go(i); play(); }); });
      this.addEventListener('mouseenter', stop); this.addEventListener('mouseleave', play);
      if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { e[0].isIntersecting ? play() : stop(); }).observe(this); else play();
    }
  }
  if (!customElements.get('sky-stl')) customElements.define('sky-stl', SkyStl);
{% endjavascript %}

{% schema %}
{
  "name": "Shop the look banner",
  "settings": [
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner image (optional)" },
    { "type": "range", "id": "height", "label": "Height on desktop", "min": 500, "max": 1000, "step": 10, "unit": "px", "default": 810 },
    { "type": "range", "id": "height_m", "label": "Height on phones", "min": 400, "max": 900, "step": 10, "unit": "px", "default": 660 },
    { "type": "color", "id": "pin_color", "label": "Hotspot colour", "default": "#ffffff" },
    { "type": "range", "id": "autoplay", "label": "Auto-change products every (0 = off)", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Enduring Stylish\nSophistication" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Enduring Stylish Sophistication blends timeless elegance with lasting style." },
    { "type": "text", "id": "look_name", "label": "Default look name", "info": "Used when a hotspot has no name of its own.", "default": "Office Wear" }
  ],
  "blocks": [
    {
      "type": "hotspot", "name": "Hotspot + product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Look name", "default": "Office Wear" },
        { "type": "header", "content": "Position on desktop" },
        { "type": "range", "id": "x", "label": "Horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 51 },
        { "type": "range", "id": "y", "label": "Vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 57 },
        { "type": "header", "content": "Position on phones" },
        { "type": "range", "id": "x_m", "label": "Horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 52 },
        { "type": "range", "id": "y_m", "label": "Vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop the look banner", "blocks": [{ "type": "hotspot", "settings": { "title": "Office Wear", "x": 51, "y": 57, "x_m": 52, "y_m": 45 } }, { "type": "hotspot", "settings": { "title": "Casual", "x": 70, "y": 61, "x_m": 70, "y_m": 60 } }] }]
}
{% endschema %}
