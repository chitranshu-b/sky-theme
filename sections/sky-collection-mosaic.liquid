      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Row height / word size",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional, otherwise collection image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label (optional)"
        },
        {
          "type": "checkbox",
          "id": "new_row",
          "label": "Start a new row here",
          "default": false
        }
      ]
    },
    {
      "type": "video_text",
      "name": "Video inside text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Word",
          "default": "Drop"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (shows through the letters)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image"
        },
        {
          "type": "checkbox",
          "id": "new_row",
          "label": "Start a new row here",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 14,
