          "settings": {}
        },
        {
          "type": "collection",
          "settings": {}
        },
        {
          "type": "collection",
          "settings": {}
        },
        {
          "type": "collection",
          "settings": {
            "new_row": true
          }
        },
        {
          "type": "collection",
          "settings": {}
        },
        {
          "type": "video_text",
          "settings": {}
        },
        {
          "type": "collection",
          "settings": {}
        }
      ]
    }
  ]
}
