{%- assign s = section.settings -%}
<section class="sk-mos sk-section" style="--sk-pt: {{ s.pt }}px; --sk-pb: {{ s.pb }}px;">
  <div class="sk-container">
    <header class="sk-mos__head">
      <h2 class="sk-h2" data-sk-words>{{ s.heading }}</h2>
      {%- if s.link_label != blank -%}<a href="{{ s.link_url | default: routes.collections_url }}" class="sk-link">{{ s.link_label }}</a>{%- endif -%}
    </header>

    {%- assign row_open = '<div class="sk-mos__row"><div class="sk-mos__items">' -%}
    {%- assign row_close = '</div></div>' -%}
    <div class="sk-mos__rows" style="--sk-ts: {{ s.text_size }}px;">
      {%- for block in section.blocks -%}
        {%- if forloop.first or block.settings.new_row -%}
          {%- unless forloop.first -%}{{- row_close -}}{%- endunless -%}
          {{- row_open -}}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'collection' -%}
            {%- assign col = block.settings.collection -%}
            {%- assign img = block.settings.image | default: col.featured_image -%}
            <a href="{{ col.url | default: '#' }}" class="sk-mos__tile" data-sk-reveal {{ block.shopify_attributes }}>
              {%- if img -%}
                <img src="{{ img | image_url: width: 900 }}" alt="{{ img.alt | default: col.title | escape }}" width="900" height="{{ 900 | divided_by: img.aspect_ratio | round }}" loading="lazy">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'sk-ph' }}
              {%- endif -%}
              <span class="sk-mos__label">{{ block.settings.title | default: col.title }}</span>
            </a>
          {%- when 'video_text' -%}
            <div class="sk-mos__vt" data-sk-reveal {{ block.shopify_attributes }}>
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '800x' }}
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="" width="900" height="{{ 900 | divided_by: block.settings.image.aspect_ratio | round }}" loading="lazy">
              {%- else -%}
                <span class="sk-vt-fallback"></span>
              {%- endif -%}
              <span class="sk-mos__mask" aria-label="{{ block.settings.text | escape }}"><b>{{ block.settings.text }}</b></span>
            </div>
        {%- endcase -%}
        {%- if forloop.last -%}{{- row_close -}}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .sk-mos__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .sk-mos__row + .sk-mos__row { margin-top: 13px; }
  .sk-mos__items { display: flex; align-items: center; column-gap: 12px; }
  .sk-mos__tile { position: relative; display: block; flex: 1 1 0%; min-width: 100px; height: calc(var(--sk-ts, 200px) * .8); min-height: 150px; overflow: hidden; border-radius: 12px; background: #ddd; transition-property: opacity, transform; }
  .sk-mos__tile img, .sk-mos__tile video, .sk-mos__tile .sk-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  a.sk-mos__tile:hover img { transform: scale(1.07); }
  .sk-mos__label { position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.85); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); font-size: 13px; font-weight: 500; opacity: 0; transform: translateY(8px); transition: .35s; }
  a.sk-mos__tile:hover .sk-mos__label { opacity: 1; transform: none; }
  /* the word sets its own width; video shows only inside the letters (white layer + "screen" blend) */
  .sk-mos__vt { position: relative; flex: 0 1 auto; border-radius: 12px; overflow: hidden; isolation: isolate; }
  .sk-mos__vt video, .sk-mos__vt img, .sk-vt-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .sk-vt-fallback { background: linear-gradient(120deg, #6a1b2c, #f08a4b, #3b6c7a); }
  .sk-mos__mask { position: relative; z-index: 2; display: block; background: #fff; mix-blend-mode: screen; padding: 0 .04em; }
  .sk-mos__mask b { display: block; font-family: var(--sk-font-head); font-weight: 700; font-size: calc(var(--sk-ts, 200px) * .8); line-height: 1; letter-spacing: 0; color: #000; text-transform: uppercase; white-space: nowrap; }
  @media (max-width: 767px) {
    .sk-mos__row { overflow: auto hidden; margin-inline-end: -16px; scrollbar-width: none; }
    .sk-mos__row::-webkit-scrollbar { display: none; }
    .sk-mos__items { width: 1200px; padding-inline-end: 16px; }
    .sk-mos__tile { min-height: 90px; }
    .sk-mos__mask b { font-size: calc(var(--sk-ts, 200px) * .5); }
    .sk-mos__tile { height: calc(var(--sk-ts, 200px) * .5); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection mosaic",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Signature Collections"
    },
    {
