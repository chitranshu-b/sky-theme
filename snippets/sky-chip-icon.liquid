    {%- when 'hand-heart' -%}<path d="M12 10.8c-3-2.1-4.6-3.4-4.6-5.1a2.5 2.5 0 014.6-1.1 2.5 2.5 0 014.6 1.1c0 1.7-1.6 3-4.6 5.1z" fill="currentColor" stroke="none"/><path d="M2.5 15.5h3.2l4.3 1.5h3.4a1.4 1.4 0 010 2.8H9.6M13.4 19.8l5.2-2c1.3-.5 2.4.2 2.4 1.2L14 22l-6-1.6H2.5z"/>
    {%- when 'wind' -%}<path d="M3 9h11a3 3 0 10-3-3M3 14h15a3 3 0 11-3 3M3 19h7"/>
    {%- when 'feather' -%}<path d="M20 4c-8 0-13 4.5-13 11l-3 5M7 15h7M11 11.5h6M20 4c0 7-4 11-11 11"/>
