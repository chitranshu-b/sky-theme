    {%- when 'dress' -%}<path fill="currentColor" stroke="none" d="M9 2h2l1 3 1-3h2l-1 6 4 13H5l4-13-1-6z"/>
    {%- when 'waves' -%}<path d="M3 7c3-3 5 3 9 0s6 3 9 0M3 12c3-3 5 3 9 0s6 3 9 0M3 17c3-3 5 3 9 0s6 3 9 0"/>
