{%- comment -%} Small line icons for the hover chips. Param: icon (check, person, hand-heart, wind, feather, hand-leaf, dress, waves, magnet) {%- endcomment -%}
<svg class="sk-cp__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case icon -%}
    {%- when 'check' -%}<circle cx="12" cy="12" r="9.5" stroke-width="2.4"/><path d="M7.5 12.5l3 3 6-6.5" stroke-width="2.4"/>
